{
  "name": "worktree-graph",
  "displayName": "Worktree Graph",
  "description": "Veja worktrees e branches num grafo, faça merge com um clique ou arrastando, e mantenha as branches sincronizadas com a base — pensado para desenvolvimento com agentes de IA.",
  "version": "0.5.0",
  "publisher": "worktree-graph",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization",
    "AI"
  ],
  "keywords": [
    "git",
    "worktree",
    "git worktree",
    "graph",
    "merge",
    "branch",
    "ai",
    "agents",
    "claude code",
    "codex",
    "sync",
    "github actions"
  ],
  "icon": "media/logo.png",
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:.git"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "worktreeGraph",
          "title": "Worktree Graph",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "worktreeGraph": [
        {
          "id": "worktreeGraph.projects",
          "name": "Projetos"
        },
        {
          "id": "worktreeGraph.worktrees",
          "name": "Worktrees"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "worktreeGraph.worktrees",
        "contents": "Lendo o repositório…",
        "when": "worktreeGraph.state == loading || !worktreeGraph.state"
      },
      {
        "view": "worktreeGraph.worktrees",
        "contents": "Nenhum repositório git encontrado neste workspace.\n[Abrir pasta](command:vscode.openFolder)",
        "when": "worktreeGraph.state == noRepo"
      },
      {
        "view": "worktreeGraph.projects",
        "contents": "Gerencie vários repositórios nesta janela.\n[Adicionar projeto](command:worktreeGraph.addProject)"
      }
    ],
    "commands": [
      {
        "command": "worktreeGraph.openGraph",
        "title": "Abrir grafo",
        "category": "Worktree Graph",
        "icon": "$(git-merge)"
      },
      {
        "command": "worktreeGraph.refresh",
        "title": "Atualizar",
        "category": "Worktree Graph",
        "icon": "$(refresh)"
      },
      {
        "command": "worktreeGraph.createWorktree",
        "title": "Nova worktree",
        "category": "Worktree Graph",
        "icon": "$(add)"
      },
      {
        "command": "worktreeGraph.openWorktree",
        "title": "Abrir worktree em nova janela",
        "category": "Worktree Graph",
        "icon": "$(empty-window)"
      },
      {
        "command": "worktreeGraph.launchAgent",
        "title": "Abrir agente (Claude Code, Codex…) na worktree",
        "category": "Worktree Graph",
        "icon": "$(sparkle)"
      },
      {
        "command": "worktreeGraph.openFileInWorktree",
        "title": "Abrir arquivo de outra worktree…",
        "category": "Worktree Graph",
        "icon": "$(go-to-file)"
      },
      {
        "command": "worktreeGraph.openTerminal",
        "title": "Abrir terminal na worktree",
        "category": "Worktree Graph",
        "icon": "$(terminal)"
      },
      {
        "command": "worktreeGraph.mergeBaseInto",
        "title": "Trazer a base para esta branch",
        "category": "Worktree Graph",
        "icon": "$(arrow-down)"
      },
      {
        "command": "worktreeGraph.mergeIntoBase",
        "title": "Mesclar esta branch na base",
        "category": "Worktree Graph",
        "icon": "$(git-merge)"
      },
      {
        "command": "worktreeGraph.mergeInto",
        "title": "Mesclar esta branch em…",
        "category": "Worktree Graph"
      },
      {
        "command": "worktreeGraph.diffWithBase",
        "title": "Revisar alterações contra a base",
        "category": "Worktree Graph",
        "icon": "$(diff)"
      },
      {
        "command": "worktreeGraph.removeWorktree",
        "title": "Remover worktree",
        "category": "Worktree Graph",
        "icon": "$(trash)"
      },
      {
        "command": "worktreeGraph.deleteBranch",
        "title": "Excluir branch",
        "category": "Worktree Graph"
      },
      {
        "command": "worktreeGraph.togglePauseSync",
        "title": "Pausar/retomar sync desta branch",
        "category": "Worktree Graph",
        "icon": "$(debug-pause)"
      },
      {
        "command": "worktreeGraph.toggleAutoSync",
        "title": "Ligar/desligar sync automático",
        "category": "Worktree Graph",
        "icon": "$(sync)"
      },
      {
        "command": "worktreeGraph.syncNow",
        "title": "Sincronizar agora",
        "category": "Worktree Graph",
        "icon": "$(sync)"
      },
      {
        "command": "worktreeGraph.generateCiWorkflow",
        "title": "Gerar workflow de CI (GitHub Actions)",
        "category": "Worktree Graph",
        "icon": "$(github-action)"
      },
      {
        "command": "worktreeGraph.showLog",
        "title": "Mostrar log",
        "category": "Worktree Graph"
      },
      {
        "command": "worktreeGraph.chooseSyncWhere",
        "title": "Escolher onde o sync roda (local, GitHub Actions, dividido, ambos)",
        "category": "Worktree Graph"
      },
      {
        "command": "worktreeGraph.cleanupWorktrees",
        "title": "Limpar worktrees… (remoção em lote)",
        "category": "Worktree Graph",
        "icon": "$(clear-all)"
      },
      {
        "command": "worktreeGraph.pruneWorktrees",
        "title": "Remover worktrees órfãs (pasta apagada)",
        "category": "Worktree Graph"
      },
      {
        "command": "worktreeGraph.toggleFavorite",
        "title": "Favoritar / desfavoritar",
        "category": "Worktree Graph",
        "icon": "$(star-empty)"
      },
      {
        "command": "worktreeGraph.publishRequest",
        "title": "Publicar PR/MR…",
        "category": "Worktree Graph",
        "icon": "$(git-pull-request-create)"
      },
      {
        "command": "worktreeGraph.analyzeMerge",
        "title": "Analisar merge…",
        "category": "Worktree Graph",
        "icon": "$(git-compare)"
      },
      {
        "command": "worktreeGraph.connectHosting",
        "title": "Conectar ao GitHub/GitLab",
        "category": "Worktree Graph",
        "icon": "$(plug)"
      },
      {
        "command": "worktreeGraph.disconnectHosting",
        "title": "Desconectar do GitHub/GitLab (apagar token)",
        "category": "Worktree Graph"
      },
      {
        "command": "worktreeGraph.configureFlow",
        "title": "Configurar fluxo de ambientes (dev → QA → homologação → produção)…",
        "category": "Worktree Graph"
      },
      {
        "command": "worktreeGraph.addToExplorer",
        "title": "Adicionar ao Explorer (workspace multi-root)",
        "category": "Worktree Graph",
        "icon": "$(files)"
      },
      {
        "command": "worktreeGraph.openToSide",
        "title": "Abrir ao lado",
        "category": "Worktree Graph"
      },
      {
        "command": "worktreeGraph.revealInOS",
        "title": "Revelar no sistema de arquivos",
        "category": "Worktree Graph"
      },
      {
        "command": "worktreeGraph.copyPath",
        "title": "Copiar caminho",
        "category": "Worktree Graph"
      },
      {
        "command": "worktreeGraph.compareWithBase",
        "title": "Comparar com a base",
        "category": "Worktree Graph"
      },
      {
        "command": "worktreeGraph.resolveConflict",
        "title": "Resolver conflito com o agente (traz a base e resolve)",
        "category": "Worktree Graph",
        "icon": "$(sparkle)"
      },
      {
        "command": "worktreeGraph.launchAgentWithPrompt",
        "title": "Abrir agente com uma tarefa",
        "category": "Worktree Graph"
      },
      {
        "command": "worktreeGraph.addProject",
        "title": "Adicionar projeto…",
        "category": "Worktree Graph",
        "icon": "$(add)"
      },
      {
        "command": "worktreeGraph.removeProject",
        "title": "Remover projeto da lista",
        "category": "Worktree Graph",
        "icon": "$(close)"
      },
      {
        "command": "worktreeGraph.switchProject",
        "title": "Trocar projeto…",
        "category": "Worktree Graph",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "worktreeGraph.openProjectGraph",
        "title": "Abrir grafo do projeto",
        "category": "Worktree Graph",
        "icon": "$(git-merge)"
      },
      {
        "command": "worktreeGraph.openProjectWindow",
        "title": "Abrir projeto numa nova janela",
        "category": "Worktree Graph",
        "icon": "$(empty-window)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "worktreeGraph.openGraph",
          "when": "view == worktreeGraph.worktrees",
          "group": "navigation@1"
        },
        {
          "command": "worktreeGraph.createWorktree",
          "when": "view == worktreeGraph.worktrees",
          "group": "navigation@2"
        },
        {
          "command": "worktreeGraph.openFileInWorktree",
          "when": "view == worktreeGraph.worktrees",
          "group": "navigation@2"
        },
        {
          "command": "worktreeGraph.toggleAutoSync",
          "when": "view == worktreeGraph.worktrees",
          "group": "navigation@3"
        },
        {
          "command": "worktreeGraph.refresh",
          "when": "view == worktreeGraph.worktrees",
          "group": "navigation@4"
        },
        {
          "command": "worktreeGraph.syncNow",
          "when": "view == worktreeGraph.worktrees",
          "group": "1_sync"
        },
        {
          "command": "worktreeGraph.generateCiWorkflow",
          "when": "view == worktreeGraph.worktrees",
          "group": "1_sync"
        },
        {
          "command": "worktreeGraph.showLog",
          "when": "view == worktreeGraph.worktrees",
          "group": "2_log"
        },
        {
          "command": "worktreeGraph.chooseSyncWhere",
          "when": "view == worktreeGraph.worktrees",
          "group": "1_sync"
        },
        {
          "command": "worktreeGraph.cleanupWorktrees",
          "when": "view == worktreeGraph.worktrees",
          "group": "3_cleanup"
        },
        {
          "command": "worktreeGraph.pruneWorktrees",
          "when": "view == worktreeGraph.worktrees",
          "group": "3_cleanup"
        },
        {
          "command": "worktreeGraph.connectHosting",
          "when": "view == worktreeGraph.worktrees",
          "group": "4_hosting"
        },
        {
          "command": "worktreeGraph.configureFlow",
          "when": "view == worktreeGraph.worktrees",
          "group": "4_hosting"
        },
        {
          "command": "worktreeGraph.addProject",
          "when": "view == worktreeGraph.projects",
          "group": "navigation@1"
        },
        {
          "command": "worktreeGraph.switchProject",
          "when": "view == worktreeGraph.projects",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "worktreeGraph.launchAgent",
          "when": "view == worktreeGraph.worktrees && viewItem =~ /^worktree/",
          "group": "inline@0"
        },
        {
          "command": "worktreeGraph.openWorktree",
          "when": "view == worktreeGraph.worktrees && viewItem =~ /^worktree/",
          "group": "inline@1"
        },
        {
          "command": "worktreeGraph.mergeBaseInto",
          "when": "view == worktreeGraph.worktrees && viewItem =~ /^worktree(-fav)?$/",
          "group": "inline@2"
        },
        {
          "command": "worktreeGraph.mergeIntoBase",
          "when": "view == worktreeGraph.worktrees && viewItem =~ /^worktree(-fav)?$/",
          "group": "inline@3"
        },
        {
          "command": "worktreeGraph.openWorktree",
          "when": "view == worktreeGraph.worktrees && viewItem =~ /^worktree/",
          "group": "1_open@1"
        },
        {
          "command": "worktreeGraph.openTerminal",
          "when": "view == worktreeGraph.worktrees && viewItem =~ /^worktree/",
          "group": "1_open@2"
        },
        {
          "command": "worktreeGraph.diffWithBase",
          "when": "view == worktreeGraph.worktrees && viewItem =~ /^worktree(-fav)?$/",
          "group": "1_open@3"
        },
        {
          "command": "worktreeGraph.mergeBaseInto",
          "when": "view == worktreeGraph.worktrees && viewItem =~ /^worktree(-fav)?$/",
          "group": "2_merge@1"
        },
        {
          "command": "worktreeGraph.mergeIntoBase",
          "when": "view == worktreeGraph.worktrees && viewItem =~ /^worktree(-fav)?$/",
          "group": "2_merge@2"
        },
        {
          "command": "worktreeGraph.mergeInto",
          "when": "view == worktreeGraph.worktrees && viewItem =~ /^worktree/",
          "group": "2_merge@3"
        },
        {
          "command": "worktreeGraph.togglePauseSync",
          "when": "view == worktreeGraph.worktrees && viewItem =~ /^worktree(-fav)?$/",
          "group": "3_sync"
        },
        {
          "command": "worktreeGraph.removeWorktree",
          "when": "view == worktreeGraph.worktrees && viewItem =~ /^worktree(-fav)?$/",
          "group": "9_danger"
        },
        {
          "command": "worktreeGraph.launchAgent",
          "when": "view == worktreeGraph.worktrees && viewItem =~ /^worktree/",
          "group": "1_open@0"
        },
        {
          "command": "worktreeGraph.openFileInWorktree",
          "when": "view == worktreeGraph.worktrees && viewItem =~ /^worktree/",
          "group": "1_open@4"
        },
        {
          "command": "worktreeGraph.toggleFavorite",
          "when": "view == worktreeGraph.worktrees && viewItem =~ /^worktree/",
          "group": "inline@9"
        },
        {
          "command": "worktreeGraph.toggleFavorite",
          "when": "view == worktreeGraph.worktrees && viewItem =~ /^worktree/",
          "group": "0_fav"
        },
        {
          "command": "worktreeGraph.analyzeMerge",
          "when": "view == worktreeGraph.worktrees && viewItem =~ /^worktree(-fav)?$/",
          "group": "2_merge@0"
        },
        {
          "command": "worktreeGraph.publishRequest",
          "when": "view == worktreeGraph.worktrees && viewItem =~ /^worktree(-fav)?$/",
          "group": "2_merge@4"
        },
        {
          "command": "worktreeGraph.addToExplorer",
          "when": "view == worktreeGraph.worktrees && viewItem =~ /^worktree/",
          "group": "1_open@5"
        },
        {
          "command": "worktreeGraph.openToSide",
          "when": "view == worktreeGraph.worktrees && viewItem == wtFile",
          "group": "1_open@1"
        },
        {
          "command": "worktreeGraph.compareWithBase",
          "when": "view == worktreeGraph.worktrees && viewItem == wtFile",
          "group": "1_open@2"
        },
        {
          "command": "worktreeGraph.revealInOS",
          "when": "view == worktreeGraph.worktrees && viewItem =~ /^wt(File|Folder)$/",
          "group": "2_path@1"
        },
        {
          "command": "worktreeGraph.copyPath",
          "when": "view == worktreeGraph.worktrees && viewItem =~ /^wt(File|Folder)$/",
          "group": "2_path@2"
        },
        {
          "command": "worktreeGraph.resolveConflict",
          "when": "view == worktreeGraph.worktrees && viewItem =~ /^worktree(-fav)?$/",
          "group": "2_merge@5"
        },
        {
          "command": "worktreeGraph.openProjectGraph",
          "when": "view == worktreeGraph.projects && viewItem =~ /^project/",
          "group": "inline@1"
        },
        {
          "command": "worktreeGraph.openProjectWindow",
          "when": "view == worktreeGraph.projects && viewItem =~ /^project/",
          "group": "inline@2"
        },
        {
          "command": "worktreeGraph.removeProject",
          "when": "view == worktreeGraph.projects && viewItem == project",
          "group": "inline@3"
        },
        {
          "command": "worktreeGraph.openProjectGraph",
          "when": "view == worktreeGraph.projects && viewItem =~ /^project/",
          "group": "1_open@1"
        },
        {
          "command": "worktreeGraph.openProjectWindow",
          "when": "view == worktreeGraph.projects && viewItem =~ /^project/",
          "group": "1_open@2"
        },
        {
          "command": "worktreeGraph.removeProject",
          "when": "view == worktreeGraph.projects && viewItem == project",
          "group": "9_remove"
        }
      ],
      "commandPalette": [
        {
          "command": "worktreeGraph.togglePauseSync",
          "when": "false"
        },
        {
          "command": "worktreeGraph.openToSide",
          "when": "false"
        },
        {
          "command": "worktreeGraph.revealInOS",
          "when": "false"
        },
        {
          "command": "worktreeGraph.copyPath",
          "when": "false"
        },
        {
          "command": "worktreeGraph.compareWithBase",
          "when": "false"
        },
        {
          "command": "worktreeGraph.addToExplorer",
          "when": "false"
        },
        {
          "command": "worktreeGraph.launchAgentWithPrompt",
          "when": "false"
        },
        {
          "command": "worktreeGraph.openProjectWindow",
          "when": "false"
        },
        {
          "command": "worktreeGraph.removeProject",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Worktree Graph",
      "properties": {
        "worktreeGraph.baseBranch": {
          "type": "string",
          "default": "",
          "description": "Branch base (ex.: master). Vazio = detecta pelo origin/HEAD, depois main/master/develop."
        },
        "worktreeGraph.worktreeRoot": {
          "type": "string",
          "default": "",
          "markdownDescription": "Pasta onde novas worktrees são criadas (ex.: `G:\\worktrees`). Vazio = `<repo>.worktrees` ao lado do repositório."
        },
        "worktreeGraph.postCreateCommand": {
          "type": "string",
          "default": "",
          "description": "Comando rodado num terminal logo após criar uma worktree (ex.: npm install)."
        },
        "worktreeGraph.agents": {
          "type": "array",
          "markdownDescription": "CLIs de agente oferecidos no botão **Agente**. O primeiro é o padrão. Use `{prompt}` no comando para digitar a tarefa antes de abrir (ex.: `claude {prompt}`). O terminal recebe `WTGRAPH_BRANCH`, `WTGRAPH_BASE` e `WTGRAPH_WORKTREE`. `promptCommand` (opcional) é usado quando a extensão manda uma tarefa pronta (ex.: resolver conflito): `{prompt}` vira o texto.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "command"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "promptCommand": {
                "type": "string"
              }
            }
          },
          "default": [
            {
              "name": "Claude Code",
              "command": "claude",
              "promptCommand": "claude {prompt}"
            },
            {
              "name": "Claude Code (com tarefa)",
              "command": "claude {prompt}"
            },
            {
              "name": "Codex CLI",
              "command": "codex",
              "promptCommand": "codex {prompt}"
            },
            {
              "name": "Gemini CLI",
              "command": "gemini",
              "promptCommand": "gemini -i {prompt}"
            }
          ]
        },
        "worktreeGraph.agentTerminalLocation": {
          "type": "string",
          "enum": [
            "panel",
            "editor"
          ],
          "enumDescriptions": [
            "No painel de terminais, embaixo.",
            "Como aba no editor, lado a lado com o código."
          ],
          "default": "panel",
          "description": "Onde abrir os terminais de agente."
        },
        "worktreeGraph.noFastForwardIntoBase": {
          "type": "boolean",
          "default": true,
          "description": "Usar --no-ff ao mesclar uma branch na base, preservando o 'formato' da branch no histórico."
        },
        "worktreeGraph.graph.maxCommits": {
          "type": "number",
          "default": 400,
          "description": "Quantidade de commits carregados no grafo."
        },
        "worktreeGraph.graph.showRemoteBranches": {
          "type": "boolean",
          "default": true,
          "description": "Mostrar branches remotas no grafo."
        },
        "worktreeGraph.refreshIntervalSeconds": {
          "type": "number",
          "default": 15,
          "description": "Intervalo de atualização automática (alterações feitas por agentes em outras worktrees)."
        },
        "worktreeGraph.statusRefresh.activeSeconds": {
          "type": "number",
          "default": 30,
          "description": "Idade máxima do git status de worktrees ativas (esta janela, favorita, com agente, com alterações ou com commit nas últimas 24 h)."
        },
        "worktreeGraph.statusRefresh.idleSeconds": {
          "type": "number",
          "default": 600,
          "description": "Idade máxima do git status das demais worktrees."
        },
        "worktreeGraph.gitConcurrency": {
          "type": "number",
          "default": 8,
          "description": "Quantos processos git rodam em paralelo ao detalhar worktrees."
        },
        "worktreeGraph.autoSync.enabledByDefault": {
          "type": "boolean",
          "default": false,
          "description": "Se o sync automático começa ligado em repositórios novos. Depois disso, o botão de ligar/desligar vale por repositório."
        },
        "worktreeGraph.autoSync.where": {
          "type": "string",
          "enum": [
            "local",
            "github",
            "split",
            "both"
          ],
          "enumDescriptions": [
            "Só a extensão sincroniza, nas worktrees desta máquina.",
            "Só o CI (GitHub Actions ou GitLab CI, gerado em Gerar CI); a extensão só mostra o estado.",
            "Local para branches não publicadas, CI para as publicadas.",
            "Os dois em todas as branches (pode gerar merges duplicados)."
          ],
          "default": "local",
          "description": "Padrão de onde o sync da base roda. O botão 'onde' do painel escolhe por repositório."
        },
        "worktreeGraph.autoSync.mode": {
          "type": "string",
          "enum": [
            "merge",
            "notify"
          ],
          "enumDescriptions": [
            "Mescla a base automaticamente nas worktrees limpas.",
            "Só avisa que a branch ficou para trás, com botão para mesclar."
          ],
          "default": "merge",
          "description": "O que o sync automático faz quando a base anda."
        },
        "worktreeGraph.autoSync.branches": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**"
          ],
          "description": "Padrões de branch que participam do sync (* = um segmento, ** = qualquer coisa). Ex.: [\"feat/**\", \"ai/**\"]."
        },
        "worktreeGraph.autoSync.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Padrões de branch que nunca são sincronizados."
        },
        "worktreeGraph.autoSync.intervalSeconds": {
          "type": "number",
          "default": 60,
          "description": "Intervalo entre verificações do sync automático."
        },
        "worktreeGraph.autoSync.fetchRemote": {
          "type": "boolean",
          "default": false,
          "description": "Fazer git fetch a cada verificação e sincronizar a partir de origin/<base> em vez da base local."
        },
        "worktreeGraph.autoSync.testCommand": {
          "type": "string",
          "default": "",
          "description": "Comando de verificação rodado na worktree depois do merge (ex.: npm test). Vazio = sem verificação."
        },
        "worktreeGraph.autoSync.testTimeoutSeconds": {
          "type": "number",
          "default": 900,
          "description": "Tempo máximo do comando de verificação."
        },
        "worktreeGraph.autoSync.rollbackOnTestFailure": {
          "type": "boolean",
          "default": true,
          "description": "Desfazer o merge (git reset --keep) quando a verificação falhar."
        },
        "worktreeGraph.flow": {
          "type": "array",
          "markdownDescription": "Fluxo de ambientes em ordem de promoção, ex.: `[\"develop\", \"qa\", \"homolog\", \"main\"]` ou objetos `{ \"branch\": \"qa\", \"label\": \"QA\" }`. Vazio = usa o que foi salvo pelo comando *Configurar fluxo de ambientes*. O primeiro estágio vira a base, a menos que `baseBranch` esteja definido.",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "branch": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "branch"
                ]
              }
            ]
          },
          "default": []
        },
        "worktreeGraph.remote": {
          "type": "string",
          "default": "origin",
          "description": "Remoto usado para push e para PRs/MRs."
        },
        "worktreeGraph.gitlab.hosts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Hosts de GitLab self-hosted cujo endereço não contém \"gitlab\", ex.: `git.empresa.com` ou `https://git.empresa.com:8443` (use a forma com esquema/porta quando o remoto for ssh e a web estiver em outra porta)."
        },
        "worktreeGraph.gitlab.apiUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "URL da API do GitLab, se não for `<host>/api/v4`."
        },
        "worktreeGraph.github.hosts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Hosts de GitHub Enterprise Server."
        },
        "worktreeGraph.github.apiUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "URL da API do GitHub Enterprise, se não for `<host>/api/v3`."
        },
        "worktreeGraph.prompts.resolveConflict": {
          "type": "string",
          "editPresentation": "multilineText",
          "default": "Na branch ${branch}, traga a ${base} (git merge ${base}) e resolva os conflitos em: ${files}. Preserve a intenção das duas mudanças, rode os testes do projeto e faça o commit do merge. Se algo for ambíguo, pergunte antes de decidir.",
          "markdownDescription": "Tarefa enviada ao agente pelo botão *Resolver com …*. Placeholders: `${branch}`, `${base}`, `${files}`."
        },
        "worktreeGraph.prompts.mergeIntoBase": {
          "type": "string",
          "editPresentation": "multilineText",
          "default": "A branch ${branch} conflita com ${base} e não pode ser mesclada nela ainda. Nesta worktree, traga a ${base} (git merge ${base}) e resolva os conflitos em: ${files}, preservando a intenção das duas mudanças. Rode os testes do projeto e faça o commit do merge, para que o merge de ${branch} em ${base} fique limpo. Não faça o merge em ${base} sem me perguntar. Se algo for ambíguo, pergunte antes de decidir.",
          "markdownDescription": "Tarefa enviada ao agente quando o conflito aparece ao mesclar a branch na base. Placeholders: `${branch}`, `${base}`, `${files}`."
        }
      }
    }
  },
